{
   "compilerOptions": {
     "module": "commonjs",
     "target": "es2021",
     "outDir": "./dist",
     "rootDir": "./src",
     "strict": true,
     "esModuleInterop": true,
    
     "strictPropertyInitialization": false,
     "resolveJsonModule": true,
     "emitDecoratorMetadata": true,
      "experimentalDecorators": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true,
      "baseUrl": "./"},
   "include": ["src/**/*"],
   "exclude": ["node_modules", "dist"]
 }